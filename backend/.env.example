# =========================================================
# ZENO AI VOICE ASSISTANT — ENVIRONMENT CONFIGURATION
# =========================================================

# --- OpenAI Configuration (Required for Reasoning, TTS & Transcription) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MODEL=tts-1
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe

# --- Tavily Web Search (Optional: enables live web trend fallback) ---
# Get an API key at https://tavily.com (optional)
TAVILY_API_KEY=

# --- RAG Knowledge Base Configuration ---
ZENO_WORKSPACE_ID=default
RAG_TOP_K=8
RAG_MIN_HYBRID_SCORE=0.25

# --- WhatsApp Lead Capture & Notifications ---
# The WhatsApp Business number visitors will message when scanning the QR code:
WHATSAPP_BUSINESS_NUMBER=+919342160653
# Verification token for Meta WhatsApp Cloud API webhooks:
WHATSAPP_VERIFY_TOKEN=zeno_whatsapp_verify_token_2026

# --- Database Storage ---
# Optional: MongoDB connection string. If omitted, Zeno automatically uses local SQLite (zeno_sme.db)
MONGODB_URI=
MONGODB_DB=zeno_sme_db

# --- Event Kiosk Host & Port Configuration ---
PORT=5173
# Optional: Set APP_URL to explicitly override the LAN IP detected for phone QR code scanning
# APP_URL=http://192.168.1.100:5173
